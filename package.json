{
  "name": "pdfeditor",
  "version": "1.0.0",
  "description": "以文档为核心的 PDF 在线编辑器：编辑原始文字/图片，添加新元素，pdf-lib 导出",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "make:sample": "node scripts/make-sample-pdf.mjs"
  },
  "keywords": ["pdf", "editor", "pdfjs", "pdf-lib"],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174"
  }
}
